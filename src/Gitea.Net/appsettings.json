{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Database": {
    "Provider": "Sqlite",
    "SqliteConnectionString": "Data Source=App_Data/gitea_net.db;Mode=ReadWriteCreate;",
    "PostgresConnectionString": ""
  },
  "Git": {
    "WindowsBinaryPath": "C:\\Program Files\\Git\\cmd\\git.exe",
    "FallbackBinaryPath": "git",
    "RepositoriesRootPath": "App_Data/repositories",
    "WorkingTempRootPath": "App_Data/temp_worktrees",
    "CommandTimeoutSeconds": 60,
    "StreamIdleTimeoutSeconds": 120,
    "MaxConcurrentProcesses": 32
  },
  "Security": {
    "AllowRegistration": true,
    "RateLimitPermitLimit": 5000,
    "AuthRateLimitPermitLimit": 20,
    "RateLimitWindowSeconds": 60
  }
}
